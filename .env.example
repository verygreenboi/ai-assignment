# Copy to .env for local development: cp .env.example .env
# Placeholder values only — this repository is public. Never commit real secrets.

# Postgres started by `docker compose up -d --wait` (service `db`, host port 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/collab_docs

# Session signing key — must be at least 32 characters
SESSION_SECRET=dev-secret-change-me-at-least-32-chars
